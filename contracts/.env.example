# Never commit the real .env. Never paste a private key into chat or a
# command — put it here only.
PRIVATE_KEY=

# RPC used by the `robinhood_testnet` / `robinhood_mainnet` aliases in foundry.toml.
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Blockscout verification (fill in once you've confirmed the testnet API URL).
BLOCKSCOUT_API_KEY=
BLOCKSCOUT_TESTNET_API_URL=

# Deploy.s.sol inputs.
ADMIN_ADDRESS=
COLLATERAL_TOKEN=
ORACLE_RESOLVER=
