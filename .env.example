# NeonDB Postgres connection string
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/paperbet?sslmode=require

# Optional: shared secret to protect the manual worker-tick endpoint
TICK_SECRET=

# Required to use /admin/new-market, cancel markets, or toggle pause.
# Market creation and cancellation (POST /api/markets, POST /api/markets/:id/cancel,
# POST /api/admin/pause) are refused with ADMIN_NOT_CONFIGURED until this is set.
ADMIN_API_KEY=

# Optional: override Binance REST base (useful for proxies)
BINANCE_API_BASE=https://api.binance.com
